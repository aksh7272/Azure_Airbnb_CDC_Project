{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "airbnbProjectak"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureSynapseDWH_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSynapseDWH'"
		},
		"CosmosDbNoSql1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'CosmosDbNoSql1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://airbnbdataak.dfs.core.windows.net/"
		},
		"AzureSynapseDWH_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "aksynapsetest.sql.azuresynapse.net"
		},
		"AzureSynapseDWH_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "airbnb_dwh"
		},
		"AzureSynapseDWH_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Sqladminuser"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "airbnbProjectak_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"AzureSynapseDWH_password": {
						"value": "[parameters('AzureSynapseDWH_password')]"
					},
					"CosmosDbNoSql1_connectionString": {
						"value": "[parameters('CosmosDbNoSql1_connectionString')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureSynapseDWH_properties_typeProperties_server": {
						"value": "[parameters('AzureSynapseDWH_properties_typeProperties_server')]"
					},
					"AzureSynapseDWH_properties_typeProperties_database": {
						"value": "[parameters('AzureSynapseDWH_properties_typeProperties_database')]"
					},
					"AzureSynapseDWH_properties_typeProperties_userName": {
						"value": "[parameters('AzureSynapseDWH_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}